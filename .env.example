# Solana network used by setup scripts and server-side market data.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=<your-helius-key>
SOLANA_WSS_URL=wss://devnet.helius-rpc.com/?api-key=<your-helius-key>
SOLANA_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=<your-helius-key>
SOLANA_DEVNET_WSS_URL=wss://devnet.helius-rpc.com/?api-key=<your-helius-key>
# Configure these for mainnet setup and runtime; keep provider keys server-side.
# SOLANA_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<your-helius-key>
# SOLANA_MAINNET_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=<your-helius-key>

# Browser transactions use the same-origin /api/rpc route; provider keys stay server-side.

# Optional deployment and smoke-test overrides.
DEPLOYER_KEYPAIR=.keys/testnet-deployer.json
# DEPLOYER_KEYPAIR_JSON=[...]
# Mainnet operations use .keys/mainnet-deployer.json by default.
CMX_LIVE_POOL=
CMX_LIVE_BASE_URL=http://127.0.0.1:3000
