# Solana network used by setup scripts and server-side market data.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
SOLANA_WSS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Optional browser-side RPC override. Anything prefixed NEXT_PUBLIC is bundled
# into the client, so use a restricted public key or omit this variable.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Optional deployment and smoke-test overrides.
DEPLOYER_KEYPAIR=.keys/testnet-deployer.json
# DEPLOYER_KEYPAIR_JSON=[...]
CMX_LIVE_POOL=
CMX_LIVE_BASE_URL=http://127.0.0.1:3000
